LOUVOR_STUDIO_SITE_URL=https://igreja-ramo.vercel.app
LOUVOR_STUDIO_WORKER_SECRET=cole-o-mesmo-segredo-configurado-na-vercel
LOUVOR_STUDIO_WORKER_ID=pc-teste
POLL_SECONDS=25
# CPU: 8 threads equilibra velocidade e uso do PC. No i5-13500, teste 12
# quando quiser priorizar a preparação e puder deixar o computador mais livre.
LOUVOR_STUDIO_CPU_THREADS=8
DEMUCS_MODEL=htdemucs
DEMUCS_TIMEOUT_SECONDS=7200

ANALYSIS_TIMEOUT_SECONDS=45

# HQ: localhost for testing, production URL only after deploying the HQ API.
HQ_TIMEOUT_SECONDS=7200
# RUBBERBAND_PATH=C:\path\to\rubberband.exe
